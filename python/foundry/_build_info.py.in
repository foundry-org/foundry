# Generated by setup.py from _build_info.py.in at build time. Do not edit.
# foundry.ops uses only the LibTorch Stable ABI: it loads on any torch >= STABLE_ABI_TARGET
# with the same CUDA major (checked in foundry/_loader.py). TORCH_VERSION is the torch the
# wheel was compiled with (informational, not a requirement).
TORCH_VERSION = "@TORCH_VERSION@"
TORCH_CUDA_VERSION = "@TORCH_CUDA_VERSION@"
STABLE_ABI_TARGET = "@STABLE_ABI_TARGET@"
BOOST_VERSION = "@BOOST_VERSION@"
